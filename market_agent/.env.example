# Optional: adds a current-news explanation. The rule engine works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional read-only live portfolio. Create the key with portfolio/account read
# permissions only; never enable order placement.
TRADING212_ENABLED=false
TRADING212_ENVIRONMENT=live
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Choose stdout, twilio, or meta. Start with stdout.
WHATSAPP_PROVIDER=stdout
WHATSAPP_TO=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v23.0
# Required for proactive production messages outside the 24-hour service window.
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en_GB
